[Unit]
Description=Konsert Distributed Worker Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/konsert/konsertd.env
ExecStart=/usr/local/bin/konsertd run --config /etc/konsert/konsertd.yaml
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
