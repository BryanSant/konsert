[Unit]
Description=Syre Central Controller Hub
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=syre
Group=syre
WorkingDirectory=/var/lib/syre
EnvironmentFile=-/etc/syre/syre.env
ExecStart=/usr/local/bin/syre serve --config /etc/syre/syre.yaml
Restart=always
RestartSec=3
LimitNOFILE=65536

# Sandboxing: the controller only needs its state directory and outbound network.
NoNewPrivileges=yes
ProtectSystem=strict
# ProtectHome is left off: SSH bootstrap reads the service user's ~/.ssh keys and known_hosts.
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
StateDirectory=syre
ReadWritePaths=/var/lib/syre

[Install]
WantedBy=multi-user.target
