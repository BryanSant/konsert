[Unit]
Description=Syre Distributed Worker Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/syre/syred.env
ExecStart=/usr/local/bin/syred run --config /etc/syre/syred.yaml
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
