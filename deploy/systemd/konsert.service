[Unit]
Description=Konsert Central Controller Hub
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=konsert
Group=konsert
WorkingDirectory=/var/lib/konsert
EnvironmentFile=-/etc/konsert/konsert.env
ExecStart=/usr/local/bin/konsert serve --config /etc/konsert/konsert.yaml
Restart=always
RestartSec=3
LimitNOFILE=65536

# Sandboxing: the controller only needs its state directory and outbound network.
NoNewPrivileges=yes
ProtectSystem=strict
# ProtectHome is left off: SSH bootstrap reads the service user's ~/.ssh keys and known_hosts.
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
StateDirectory=konsert
ReadWritePaths=/var/lib/konsert

[Install]
WantedBy=multi-user.target
