[Unit]
Description=Syre Podman Worker Container
After=network-online.target

[Container]
Image=ghcr.io/bryansant/syred:latest
AutoUpdate=registry
Environment=SYRE_ISOLATION=container
Environment=SYRE_HOST_GROUP=%H
EnvironmentFile=/etc/syre/syred.env
Volume=%h/src:/workspace:Z
Exec=run --max-concurrent=2

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
